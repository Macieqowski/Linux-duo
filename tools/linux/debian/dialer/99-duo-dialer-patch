// Surface Duo: after every dpkg run, put the call-page fix back into Plasma Dialer if an upgrade replaced the binary
// (tools/linux/debian/dialer/duo-dialer-callpage-patch.py; does nothing when it is already patched or not installed)
DPkg::Post-Invoke { "if [ -x /usr/libexec/duo/duo-dialer-callpage-patch ]; then /usr/libexec/duo/duo-dialer-callpage-patch --install >/dev/null 2>&1 || true; fi"; };
