#!/usr/bin/gjs -m
// SPDX-License-Identifier: GPL-2.0-or-later
// Surface Duo touch calibration ("Kalibracja dotyku", 2026-11-20). One fullscreen window per screen shows 13
// crosshairs one after the other (edges at 6 % / 94 %, quarter points, centre); the person taps the centre of each.
// The taps come through the correction duo-touch-fix applies now (without it a tap aimed at the bottom crosshairs of
// DSI-2 lands in Plasma Mobile's bottom gesture strip and opens the panel); the app takes the current map from the
// daemon and turns each tap back into the uncorrected position (the map is piecewise linear and increasing, so its
// inverse swaps the knots), which is the digitizer's own error. Per screen and axis the taps at the same target line
// are averaged into [uncorrected, target] pairs (output 0..1); "Zapisz" sends them to duo-touch-fix, which applies
// them at once and keeps them in /etc/duo/touch-calibration.json. "Bez korekcji" removes that screen's correction. After saving, the window becomes a
// test page: every touch draws a dot where the system sees it.
// Run in the desktop session: duo-touch-calib [DSI-1 DSI-2] (default: every screen). Also prints one JSON line per
// screen on stdout.
import Gtk from 'gi://Gtk?version=4.0';
import Gdk from 'gi://Gdk?version=4.0';
import Gio from 'gi://Gio';
import GLib from 'gi://GLib';
import System from 'system';

const SOCK = '/run/duo-touch-fix.sock';
const E = 0.06;
const FR = [[0.5, 0.5], [E, E], [0.5, E], [1 - E, E], [1 - E, 0.5], [1 - E, 1 - E], [0.5, 1 - E], [E, 1 - E],
            [E, 0.5], [0.25, 0.5], [0.75, 0.5], [0.5, 0.25], [0.5, 0.75]];
const MAX_MISS = 80;  // px: a tap further away is a slip, not a calibration point (asked again)

// --- duo-touch-fix socket ---
let conn = null, cin = null;
function fixConnect() {
    try {
        conn = new Gio.SocketClient().connect(Gio.UnixSocketAddress.new(SOCK), null);
        cin = new Gio.DataInputStream({base_stream: conn.get_input_stream()});
        return true;
    } catch (e) {
        printerr('duo-touch-fix: ' + e.message);
        conn = null;
        return false;
    }
}
function fix(obj) {
    if (!conn)
        return null;
    try {
        conn.get_output_stream().write_all(new TextEncoder().encode(JSON.stringify(obj) + '\n'), null);
        const [line] = cin.read_line_utf8(null);
        return line ? JSON.parse(line) : null;
    } catch (e) {
        printerr('duo-touch-fix: ' + e.message);
        return null;
    }
}

// the map duo-touch-fix builds from [measured, target] pairs (its class Map): (0,0), the increasing knots, (1,1)
function knots(prs) {
    const k = (prs || []).map(([m, t]) => [+m, +t]).filter(([m, t]) => m > 0 && m < 1 && t > 0 && t < 1)
        .sort((a, b) => a[0] - b[0] || a[1] - b[1]);
    const pts = [[0, 0]];
    for (const [m, t] of k) {
        const [pm, pt] = pts[pts.length - 1];
        if (m > pm + 1e-4 && t > pt + 1e-4)
            pts.push([m, t]);
    }
    pts.push([1, 1]);
    while (pts.length > 2 && pts[pts.length - 2][1] >= 1 - 1e-4)
        pts.splice(pts.length - 2, 1);
    return pts;
}
const IDENTITY = [[0, 0], [1, 1]];
// corrected position (0..1) -> the uncorrected one: the inverse of the piecewise-linear map
function unmap(pts, v) {
    if (v <= 0 || v >= 1)
        return v;
    for (let i = 1; i < pts.length; i++) {
        if (v <= pts[i][1]) {
            const [m0, t0] = pts[i - 1], [m1, t1] = pts[i];
            return m0 + (v - t0) * (m1 - m0) / (t1 - t0);
        }
    }
    return v;
}

function pairs(taps, axis, size) {
    const groups = new Map();
    for (const p of taps) {
        const t = +(p['t' + axis] / size).toFixed(3);
        if (!groups.has(t))
            groups.set(t, []);
        groups.get(t).push(p[axis] / size);
    }
    return [...groups].sort((a, b) => a[0] - b[0])
        .map(([t, ms]) => [+(ms.reduce((a, b) => a + b, 0) / ms.length).toFixed(4), t]);
}

const app = new Gtk.Application({application_id: 'org.duo.TouchCalib'});
let open = 0, haveFix = false;

function screenWindow(monitor) {
    const want = monitor.get_connector() || 'screen';
    let name = want, geo = monitor.get_geometry();  // the screen the window is really on (enter-monitor below)
    const win = new Gtk.ApplicationWindow({application: app, title: 'Kalibracja dotyku ' + want});
    const overlay = new Gtk.Overlay();
    const area = new Gtk.DrawingArea({hexpand: true, vexpand: true});
    // between the 25 % and 50 % target rows; not a touch target itself (taps must reach the drawing area)
    const label = new Gtk.Label({valign: Gtk.Align.START, halign: Gtk.Align.CENTER, margin_top: 225, wrap: true,
                                 justify: Gtk.Justification.CENTER, max_width_chars: 30, can_target: false});
    const box = new Gtk.Box({orientation: Gtk.Orientation.VERTICAL, spacing: 14, valign: Gtk.Align.END,
                             halign: Gtk.Align.CENTER, margin_bottom: 60, visible: false});
    const mk = text => { const b = new Gtk.Button({label: text}); b.set_size_request(260, 56); box.append(b); return b; };
    const bSave = mk('Zapisz'), bReset = mk('Bez korekcji'), bAgain = mk('Jeszcze raz'), bClose = mk('Zamknij');
    overlay.set_child(area);
    overlay.add_overlay(label);
    overlay.add_overlay(box);
    win.set_child(overlay);
    // phases: wait (window not yet full screen), nofull (gave up waiting), measure, paused (long press), result, test
    const st = {phase: 'wait', i: 0, taps: [], dots: [], lastUp: 0, miss: false, result: null, mon: null};
    const say = t => label.set_markup('<span size="large" foreground="white">' + t + '</span>');
    // full screen on the asked screen. Both screens have the same size, so the size alone does not tell which one:
    // 2026-11-20 a DSI-2 window went full screen on DSI-1 and the left screen's taps were saved as DSI-2's
    const full = () => st.mon !== null && name === want &&
        Math.abs(area.get_width() - geo.width) <= 2 && Math.abs(area.get_height() - geo.height) <= 2;

    function start() {
        st.phase = 'measure'; st.i = 0; st.taps = []; st.dots = []; st.miss = false;
        box.visible = false;
        // the correction now applied to this screen (none if duo-touch-fix does not handle its touchscreen)
        const s = haveFix ? fix({cmd: 'status'}) : null;
        const cur = s && s.screens && s.screens[name];
        const handled = s && Array.isArray(s.devices) && s.devices.some(d => d.output === name);
        st.kx = cur && handled ? knots(cur.x) : IDENTITY;
        st.ky = cur && handled ? knots(cur.y) : IDENTITY;
        if (haveFix && !s)
            printerr(`${name}: no status from duo-touch-fix, measuring as uncorrected`);
        prompt();
        area.queue_draw();
    }
    function prompt() {
        say((st.miss ? 'Za daleko od krzyżyka, jeszcze raz.\n' : '') +
            `${name}: dotknij dokładnie środka krzyżyka (${st.i + 1}/${FR.length})\n` +
            '(przytrzymaj palec, żeby przerwać)');
    }
    function finish() {
        const w = area.get_width(), h = area.get_height();
        if (!full()) {  // the window changed size while measuring: its fractions are not the screen's
            st.phase = 'nofull';
            notFull();
            return;
        }
        const r = {screen: name, width: w, height: h, taps: st.taps, x: pairs(st.taps, 'x', w), y: pairs(st.taps, 'y', h)};
        const mean = a => +(a.reduce((x, y) => x + y, 0) / a.length).toFixed(1);
        const err = st.taps.map(p => Math.hypot(p.x - p.tx, p.y - p.ty));
        const cerr = st.taps.map(p => Math.hypot(p.cx - p.tx, p.cy - p.ty));
        r.mean_err_px = mean(err);
        r.max_err_px = +Math.max(...err).toFixed(1);
        r.mean_err_now_px = mean(cerr);
        r.max_err_now_px = +Math.max(...cerr).toFixed(1);
        print(JSON.stringify(r));
        st.result = r;
        st.phase = 'result';
        say(`${name}: bez korekcji średni błąd ${r.mean_err_px} px, największy ${r.max_err_px} px;\n` +
            `z obecną korekcją ${r.mean_err_now_px} px, największy ${r.max_err_now_px} px.` +
            (haveFix ? '\nZapisać korekcję dla tego ekranu?' : '\nUsługa duo-touch-fix nie działa: tylko pomiar.'));
        bSave.sensitive = bReset.sensitive = haveFix;
        box.visible = true;
        area.queue_draw();
    }
    function test(msg) {
        st.phase = 'test'; st.dots = [];
        box.visible = true;
        bSave.visible = bReset.visible = false;
        say(msg + '\nDotykaj ekranu: kropka pokazuje, gdzie system widzi palec.');
        area.queue_draw();
    }

    bSave.connect('clicked', () => {
        const s = {}; s[name] = {x: st.result.x, y: st.result.y};
        const r = fix({cmd: 'save', screens: s});
        test(r && r.ok ? 'Zapisane.' : 'Nie udało się zapisać.');
    });
    bReset.connect('clicked', () => {
        const r = fix({cmd: 'reset', screens: [name]});
        test(r && r.ok ? 'Korekcja usunięta.' : 'Nie udało się usunąć korekcji.');
    });
    bAgain.connect('clicked', () => { bSave.visible = bReset.visible = true; whenFull(); });
    bClose.connect('clicked', () => win.close());

    area.set_draw_func((a, cr, w, h) => {
        cr.setSourceRGB(0.05, 0.05, 0.1); cr.rectangle(0, 0, w, h); cr.fill();
        cr.setLineWidth(2);
        if (st.phase === 'measure') {
            const x = FR[st.i][0] * w, y = FR[st.i][1] * h;
            cr.setSourceRGB(1, 0.85, 0.2);
            cr.moveTo(x - 30, y); cr.lineTo(x + 30, y); cr.moveTo(x, y - 30); cr.lineTo(x, y + 30); cr.stroke();
            cr.arc(x, y, 12, 0, 2 * Math.PI); cr.stroke();
        } else if (st.phase === 'result') {
            for (const p of st.taps) {  // yellow: target, blue: without correction, green: with the current one
                cr.setSourceRGB(1, 0.85, 0.2); cr.arc(p.tx, p.ty, 4, 0, 2 * Math.PI); cr.fill();
                cr.setSourceRGB(0.3, 0.9, 1); cr.moveTo(p.tx, p.ty); cr.lineTo(p.x, p.y); cr.stroke();
                cr.arc(p.x, p.y, 4, 0, 2 * Math.PI); cr.fill();
                cr.setSourceRGB(0.3, 1, 0.4); cr.arc(p.cx, p.cy, 3, 0, 2 * Math.PI); cr.fill();
            }
        } else if (st.phase === 'test') {
            cr.setSourceRGB(0.4, 0.4, 0.5);
            for (const f of [0.25, 0.5, 0.75]) {
                cr.moveTo(f * w, 0); cr.lineTo(f * w, h); cr.moveTo(0, f * h); cr.lineTo(w, f * h);
            }
            cr.stroke();
            cr.setSourceRGB(0.3, 0.9, 1);
            for (const [x, y] of st.dots.slice(-12)) {
                cr.moveTo(x - 20, y); cr.lineTo(x + 20, y); cr.moveTo(x, y - 20); cr.lineTo(x, y + 20); cr.stroke();
                cr.arc(x, y, 5, 0, 2 * Math.PI); cr.fill();
            }
        }
        cr.$dispose();
    });

    const g = new Gtk.GestureClick();
    let down = null, downAt = 0;
    g.connect('pressed', (_g, _n, x, y) => { down = [x, y]; downAt = GLib.get_monotonic_time(); });
    g.connect('released', (_g, _n, x, y) => {
        const now = GLib.get_monotonic_time(), d = down || [x, y];
        down = null;
        if (st.phase === 'test') { st.dots.push(d); area.queue_draw(); return; }
        if (st.phase !== 'measure')
            return;
        if (downAt - st.lastUp < 250000) { st.lastUp = now; return; }  // a double tap / a split touch: ignore
        st.lastUp = now;
        const w = area.get_width(), h = area.get_height();
        const tx = FR[st.i][0] * w, ty = FR[st.i][1] * h;
        if (Math.hypot(d[0] - tx, d[1] - ty) > MAX_MISS) { st.miss = true; prompt(); return; }
        st.miss = false;
        // seen through the current correction (cx, cy); x, y = where it would be without it
        st.taps.push({tx: +tx.toFixed(1), ty: +ty.toFixed(1), cx: +d[0].toFixed(1), cy: +d[1].toFixed(1),
                      x: +(unmap(st.kx, d[0] / w) * w).toFixed(1), y: +(unmap(st.ky, d[1] / h) * h).toFixed(1)});
        st.i++;
        if (st.i >= FR.length)
            finish();
        else
            prompt();
        area.queue_draw();
    });
    area.add_controller(g);
    // a long press stops the measurement (the buttons are hidden while it runs)
    const lp = new Gtk.GestureLongPress({delay_factor: 3.0});
    lp.connect('pressed', () => {
        if (st.phase !== 'measure')
            return;
        st.phase = 'paused';
        say(`${name}: pomiar przerwany.`);
        bSave.visible = bReset.visible = false;
        box.visible = true;
        area.queue_draw();
    });
    area.add_controller(lp);
    win.connect('close-request', () => {
        if (--open <= 0)
            app.quit();
        return false;
    });
    function notFull() {
        const size = `${area.get_width()}x${area.get_height()}`;
        const where = st.mon === null ? 'unknown screen' : name;
        printerr(`${want}: window ${size} on ${where}, screen ${geo.width}x${geo.height}: not measuring`);
        say(st.mon !== null && name !== want
            ? `${want}: okno jest na ekranie ${name}, nie na ${want},\npomiar byłby błędny. Naciśnij „Jeszcze raz”.`
            : `${want}: okno nie zajmuje całego ekranu (${size} zamiast ${geo.width}x${geo.height}),\n` +
              'pomiar byłby błędny. Naciśnij „Jeszcze raz”.');
        bSave.visible = bReset.visible = false;
        box.visible = true;
        area.queue_draw();
    }
    // measure only once the window covers the whole asked screen. KWin (Plasma Mobile) may first keep it maximized
    // between the panels: then the taps would be measured in the window's fractions, not the screen's (DSI-2
    // 2026-11-20: 529x648 of 529x706), or put it on the other screen. Full screen on the asked screen is requested
    // again every 1.5 s; after 9 s without it, no measurement.
    function whenFull() {
        st.phase = 'wait';
        box.visible = false;
        say(`${name}: chwila...`);
        area.queue_draw();
        let waited = 0;
        GLib.timeout_add(GLib.PRIORITY_DEFAULT, 100, () => {
            if (st.phase !== 'wait')
                return GLib.SOURCE_REMOVE;
            if (full()) {
                start();
                return GLib.SOURCE_REMOVE;
            }
            waited += 100;
            if (waited % 1500 === 0) {
                win.unfullscreen();
                win.fullscreen_on_monitor(monitor);
            }
            if (waited >= 9000) {
                st.phase = 'nofull';
                notFull();
                return GLib.SOURCE_REMOVE;
            }
            return GLib.SOURCE_CONTINUE;
        });
    }
    open++;
    win.present();
    const surf = win.get_surface();
    surf.connect('enter-monitor', (_s, m) => {
        st.mon = m;
        name = m.get_connector() || 'screen';
        geo = m.get_geometry();
    });
    surf.connect('leave-monitor', (_s, m) => {
        if (st.mon === m)
            st.mon = null;
    });
    win.fullscreen_on_monitor(monitor);
    whenFull();
}

app.connect('activate', () => {
    haveFix = fixConnect();
    const want = ARGV.length ? ARGV : null;
    const mons = Gdk.Display.get_default().get_monitors();
    for (let i = 0; i < mons.get_n_items(); i++) {
        const m = mons.get_item(i);
        if (!want || want.includes(m.get_connector()))
            screenWindow(m);
    }
    if (!open) { printerr('no matching screen'); app.quit(); }
});
System.exit(app.run([System.programInvocationName]));
