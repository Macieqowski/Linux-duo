#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Surface Duo touch position correction (duo-touch-fix, 2026-11-20).

iptsd turns each digitizer's heatmap into a "IPTSD Virtual Touchscreen 045E:0C0x" evdev device, and KWin maps it onto
its screen through duo-hw's udev rule (WL_OUTPUT + LIBINPUT_CALIBRATION_MATRIX). That linear mapping is not enough
near the edges: measured with duo-touch-calib, taps land up to ~38 px (3 mm) too far out towards some edges and the
error is not linear (Android's Microsoft touch library has its own edge correction; iptsd has none), so a libinput
matrix cannot fix it.

This daemon puts one corrected copy in front of each iptsd touchscreen: it grabs the iptsd device (EVIOCGRAB: KWin no
longer gets its events), creates a uinput clone with the same capabilities, named "Duo Touchscreen 045E:0C0x" (so
duo-posture / duo-call-audio, which match "Touchscreen 045E:0C0x", switch both), gives the clone the same udev
WL_OUTPUT + matrix, and forwards every event, with the positions passed through a per-axis piecewise-linear map.
If the daemon stops, the grab ends and the iptsd devices work as before (uncorrected).
KWin does not take the screen from udev for a device it has settings for in ~/.config/kcminputrc (an empty
OutputName there wins), so the iptsd device is grabbed only once KWin has mapped the clone onto the same screen: the
daemon sets the clone's outputName, calibration matrix and enabled (as KWin has them for the iptsd device) through
KWin's D-Bus, as the session's user; KWin keeps them in kcminputrc. Without a session (or KWin) the clone waits and the iptsd device stays in use.

Edges (2026-11-20): the digitizer's outermost heatmap line on every side is a copy of the next one (no own signal),
and iptsd's Gaussian fit then cannot get a finger closer than ~0.2 lines to the border: everything from ~6 % of the
screen outwards reads ~1 %, which no per-axis map can undo. So the daemon also reads each digitizer's heatmap from its
hidraw node (read-only, next to iptsd) and, for a contact within ~4 lines of a border, puts its own estimate in the
place of iptsd's along that axis: the finger's inner flank (where the profile from the border inwards falls to half
its peak; untouched by the copied border line and by the firmware gating the second line on and off) minus the
finger's half-width. A finger lying only on the line next to the border is taken as touching the border, and the
positions in between are stretched linearly onto it - what Android's Microsoft touch library does (StretchToBorder in
libsurfacetouch.so). Further in it fades into iptsd's own position. {"cmd":"edge","on":false} switches it off until
the daemon restarts; {"cmd":"watch"} streams the estimates.

The map comes from /etc/duo/touch-calibration.json, written through the socket by the calibration app
(duo-touch-calib): per screen and output axis, pairs [measured, target] in the output's 0..1 coordinates, measured
without correction ("raw" mode, which the app holds while it measures). The screen edges always map onto themselves.
Socket /run/duo-touch-fix.sock, one JSON object per line: {"cmd":"raw"} (no correction while this connection is
open, or until {"cmd":"normal"}), {"cmd":"save","screens":{"DSI-2":{"x":[[m,t],..],"y":[[m,t],..]}}} (merged per
screen), {"cmd":"reset","screens":["DSI-2"]} (no correction for those screens; no list = all), {"cmd":"status"}.
Run as root (uinput, EVIOCGRAB): duo-touch-fix.service.
"""
import fcntl, glob, json, os, pwd, re, select, socket, struct, subprocess, sys, time

CONF = '/etc/duo/touch-calibration.json'
SOCK = '/run/duo-touch-fix.sock'
RULES = '/run/udev/rules.d/91-duo-touch-fix.rules'
SRC = 'IPTSD Virtual Touchscreen'
DST = 'Duo Touchscreen'
EV_SYN, EV_KEY, EV_ABS, EV_MSC = 0, 1, 3, 4
SYN_REPORT, SYN_DROPPED = 0, 3
ABS_X, ABS_Y, ABS_MT_SLOT, ABS_MT_POSITION_X, ABS_MT_POSITION_Y, ABS_MT_TRACKING_ID = 0x00, 0x01, 0x2f, 0x35, 0x36, 0x39
EVENT = struct.Struct('llHHi')  # struct input_event, 64-bit
# the Surface Duo digitizer's heatmap in its hidraw reports: 21 rows (iptsd Y, row 0 = Y 0) x 27 columns (iptsd X,
# inverted: column 0 = X max), u8, at byte 26 (measured 2026-11-20 with touch-capture)
HM_OFF, HM_ROWS, HM_COLS = 26, 21, 27
EDGE = {
    'near': 4.5,  # only contacts that iptsd puts within this many lines of a border
    'blend': (3.0, 4.0),  # own estimate below, iptsd's above, linear in between (lines from the border)
    'r': {'col': 1.06, 'row': 1.12},  # finger half-width at half signal along each axis (lines; median, 2026-11-20)
    'a': 0.5,  # the stretch ends at half-width + a lines from the border (Android: r + a)
    'min': 40,  # peak of the 3-line profile below this: no estimate
}


def _ioc(d, nr, size):
    return (d << 30) | (size << 16) | (0x45 << 8) | nr


EVIOCGRAB = 0x40044590
EVIOCGID = _ioc(2, 0x02, 8)
EVIOCGBIT = lambda ev, n: _ioc(2, 0x20 + ev, n)
EVIOCGABS = lambda code: _ioc(2, 0x40 + code, 24)
EVIOCGPROP = _ioc(2, 0x09, 8)
EVIOCGMTSLOTS_64 = _ioc(2, 0x0a, 4 + 4 * 64)
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_MSCBIT, UI_SET_PROPBIT = (0x40045564, 0x40045565, 0x40045567,
                                                                            0x40045568, 0x4004556e)
UI_DEV_SETUP, UI_ABS_SETUP, UI_DEV_CREATE, UI_DEV_DESTROY = 0x405c5503, 0x401c5504, 0x5501, 0x5502
UI_SET = {EV_KEY: (UI_SET_KEYBIT, 0x2ff), EV_ABS: (UI_SET_ABSBIT, 0x3f), EV_MSC: (UI_SET_MSCBIT, 0x07)}


def log(msg):
    print(time.strftime('%H:%M:%S ') + msg, flush=True)


def bits(fd, ev, top):
    buf = bytearray((top + 8) // 8)
    fcntl.ioctl(fd, EVIOCGBIT(ev, len(buf)), buf)
    return [i for i in range(top + 1) if buf[i // 8] >> (i % 8) & 1]


def udev_props(node):
    out = subprocess.run(['udevadm', 'info', '--query=property', '--name=' + node], capture_output=True, text=True)
    return dict(l.split('=', 1) for l in out.stdout.splitlines() if '=' in l)


def session_user():
    """the logged-in desktop user (uid >= 1000 with a session bus), or None"""
    for d in sorted(os.listdir('/run/user')) if os.path.isdir('/run/user') else []:
        try:
            u = pwd.getpwuid(int(d))
        except (KeyError, ValueError):
            continue
        if 1000 <= u.pw_uid < 65534 and os.path.exists('/run/user/%d/bus' % u.pw_uid):
            return u
    return None


def kwin(args, timeout=5):
    """busctl --user ARGS against KWin, as the session's user; stdout, or None"""
    u = session_user()
    if not u:
        return None
    env = {'XDG_RUNTIME_DIR': '/run/user/%d' % u.pw_uid, 'PATH': '/usr/bin:/bin', 'HOME': u.pw_dir,
           'DBUS_SESSION_BUS_ADDRESS': 'unix:path=/run/user/%d/bus' % u.pw_uid}
    try:
        r = subprocess.run(['busctl', '--user'] + args, user=u.pw_uid, group=u.pw_gid, env=env, capture_output=True,
                           text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def kwin_prop(event, prop, value=None):
    """get (value None) or set an org.kde.KWin.InputDevice property of /dev/input/EVENT; get returns the value text"""
    path = '/org/kde/KWin/InputDevice/' + event
    if value is None:
        out = kwin(['get-property', 'org.kde.KWin', path, 'org.kde.KWin.InputDevice', prop])
        if out is None:
            return None
        m = re.match(r'\s*\w+\s+(.*)', out)
        return m.group(1).strip().strip('"') if m else None
    sig = 'b' if isinstance(value, bool) else 's'
    v = ('true' if value else 'false') if isinstance(value, bool) else value
    return kwin(['set-property', 'org.kde.KWin', path, 'org.kde.KWin.InputDevice', prop, sig, v]) is not None


def matrix16(text):
    """KWin's calibrationMatrix text -> 16 floats, or None"""
    try:
        v = [round(float(x), 5) for x in (text or '').split(',')]
    except ValueError:
        return None
    return v if len(v) == 16 else None


def event_of(name):
    """eventN of the input device with this exact name, or None"""
    for p in glob.glob('/sys/class/input/event*/device/name'):
        try:
            if open(p).read().strip() == name:
                return p.split('/')[4]
        except OSError:
            pass
    return None


def hidraw_of(vid, pid):
    """/dev/hidrawN of the HID device vid:pid, or None"""
    for p in sorted(glob.glob('/sys/class/hidraw/hidraw*/device/uevent')):
        try:
            ids = dict(l.split('=', 1) for l in open(p).read().splitlines() if '=' in l).get('HID_ID', '')
            _, v, d = (int(x, 16) for x in ids.split(':'))
        except (OSError, ValueError):
            continue
        if (v, d) == (vid, pid):
            return '/dev/' + p.split('/')[4]
    return None


def edge_est(prof, u, r):
    """distance of a contact from a border, in heatmap lines, from the profile prof[k] of the lines k = 1.. from the
    border inwards (prof[0] unused: the border line only copies line 1); u = iptsd's distance. None: keep iptsd's"""
    top = min(len(prof) - 1, int(u + 3.5))  # the peak is this contact's: iptsd's distance is never too large
    a = max(prof[1:top + 1])
    if a < EDGE['min']:
        return None
    kp = prof.index(a, 1)
    h = a / 2.0
    kh = None
    for i in range(kp, len(prof) - 1):
        if prof[i] >= h > prof[i + 1]:
            kh = i + (prof[i] - h) / float(prof[i] - prof[i + 1])  # the inner flank at half the peak
            break
    if kh is None:
        return None
    d = kh - r
    if abs(d - u) > 3.0:
        return None
    d0, t = 1.5 - r, r + EDGE['a']  # d0: the finger only on line 1 = at the border
    out = t * (d - d0) / (t - d0) if d < t else d
    b0, b1 = EDGE['blend']
    w = min(1.0, max(0.0, (d - b0) / (b1 - b0)))
    return max(0.0, (1.0 - w) * out + w * u)


class Heat:
    """one digitizer's latest heatmap, read from its hidraw node alongside iptsd (hidraw gives every reader a copy)"""

    def __init__(self, path):
        self.path = path
        self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        self.hm, self.t, self.sig, self.rid = None, 0.0, None, None

    def drain(self):
        last = None
        while True:
            try:
                b = os.read(self.fd, 4096)
            except BlockingIOError:
                break
            except OSError:
                break
            if not b:
                break
            if len(b) >= HM_OFF + HM_ROWS * HM_COLS:
                last = b
        if last is not None:
            self.hm, self.t, self.sig = last[HM_OFF:HM_OFF + HM_ROWS * HM_COLS], time.monotonic(), None
            if self.rid is None:
                self.rid = last[0]

    def signal(self):
        """the heatmap as touch signal >= 0 (neutral = the most common value, the finger's side of it), or None"""
        if self.hm is None or time.monotonic() - self.t > 0.05:
            return None
        if self.sig is None:
            hm = self.hm
            neutral = max(set(hm), key=hm.count)
            if hm.count(neutral) < len(hm) // 4:
                self.sig = False  # not a heatmap report
            else:
                pol = 1 if max(hm) - neutral >= neutral - min(hm) else -1
                self.sig = [max(0, (b - neutral) * pol) for b in hm]
        return self.sig or None

    def close(self):
        os.close(self.fd)


class Map:
    """piecewise-linear map on 0..1 through (0,0), the measured knots, (1,1)"""

    def __init__(self, pairs=()):
        k = sorted((float(m), float(t)) for m, t in pairs if 0.0 < float(m) < 1.0 and 0.0 < float(t) < 1.0)
        pts = [(0.0, 0.0)]
        for m, t in k:  # keep it strictly increasing in both
            if m > pts[-1][0] + 1e-4 and t > pts[-1][1] + 1e-4:
                pts.append((m, t))
        pts.append((1.0, 1.0))
        while len(pts) > 2 and pts[-2][1] >= 1.0 - 1e-4:
            pts.pop(-2)
        self.pts = pts

    def __call__(self, v):
        p = self.pts
        if v <= 0.0 or v >= 1.0:
            return v
        for i in range(1, len(p)):
            if v <= p[i][0]:
                (m0, t0), (m1, t1) = p[i - 1], p[i]
                return t0 + (v - m0) * (t1 - t0) / (m1 - m0)
        return v

    def identity(self):
        return len(self.pts) == 2


class Dev:
    def __init__(self, node, name, output, matrix):
        self.node, self.name, self.output, self.matrix = node, name, output, matrix
        self.suffix = name[len(SRC):].strip()
        self.dst = ('%s %s' % (DST, self.suffix)).strip()
        self.fd = os.open(node, os.O_RDONLY | os.O_NONBLOCK)
        self.ui = None
        self.grabbed = False
        self.waiting = None  # what the grab waits for (logged once per change)
        try:
            self.evs = bits(self.fd, 0, 0x1f)
            self.caps = {ev: bits(self.fd, ev, UI_SET[ev][1]) for ev in UI_SET if ev in self.evs}
            self.abs = {}
            for code in self.caps.get(EV_ABS, []):
                buf = bytearray(24)
                fcntl.ioctl(self.fd, EVIOCGABS(code), buf)
                self.abs[code] = struct.unpack('6i', buf)  # value min max fuzz flat resolution
            buf = bytearray(8)
            fcntl.ioctl(self.fd, EVIOCGPROP, buf)
            self.props = [i for i in range(64) if buf[i // 8] >> (i % 8) & 1]
            buf = bytearray(8)
            fcntl.ioctl(self.fd, EVIOCGID, buf)
            self.id = struct.unpack('4H', buf)
        except OSError:
            os.close(self.fd)
            raise
        self.mx = self.my = Map()
        self.heat = None
        try:
            v, p = (int(x, 16) for x in self.suffix.split(':'))
            h = hidraw_of(v, p)
            if h:
                self.heat = Heat(h)
        except (ValueError, OSError) as e:
            log('%s: no heatmap (%s)' % (self.dst, e))
        self.edge = self.heat is not None
        self.watch = None  # callback for {"cmd":"watch"}
        self.slot, self.fslot, self.slots, self.sent, self.frame = 0, None, {}, {}, []
        self.st = [self.abs.get(ABS_X, (0,))[0], self.abs.get(ABS_Y, (0,))[0]]  # the single-touch copy
        self.maxx = self.abs.get(ABS_MT_POSITION_X, (0, 0, 0))[2]
        self.maxy = self.abs.get(ABS_MT_POSITION_Y, (0, 0, 0))[2]

    def create(self):
        ui = os.open('/dev/uinput', os.O_WRONLY | os.O_NONBLOCK)
        try:
            for ev in self.evs:
                fcntl.ioctl(ui, UI_SET_EVBIT, ev)
            for ev, codes in self.caps.items():
                for c in codes:
                    fcntl.ioctl(ui, UI_SET[ev][0], c)
            for p in self.props:
                fcntl.ioctl(ui, UI_SET_PROPBIT, p)
            for code, (v, lo, hi, fuzz, flat, res) in self.abs.items():
                fcntl.ioctl(ui, UI_ABS_SETUP, struct.pack('HHiiiiii', code, 0, v, lo, hi, fuzz, flat, res))
            fcntl.ioctl(ui, UI_DEV_SETUP, struct.pack('HHHH80sI', *self.id, self.dst.encode()[:79], 0))
            fcntl.ioctl(ui, UI_DEV_CREATE)
        except OSError:
            os.close(ui)
            raise
        self.ui = ui

    def kwin_ready(self):
        """True once KWin has the clone on the iptsd device's screen (set over D-Bus if not) and as enabled"""
        clone, orig = event_of(self.dst), self.node.rsplit('/', 1)[1]
        if not clone:
            return self.wait('the clone in sysfs')
        out = kwin_prop(clone, 'outputName')
        if out is None:
            return self.wait('KWin (session) for ' + clone)
        if out != self.output:
            kwin_prop(clone, 'outputName', self.output)
            out = kwin_prop(clone, 'outputName')
            if out != self.output:
                return self.wait('KWin to map %s onto %s (has "%s")' % (clone, self.output, out))
            log('%s (%s): KWin output set to %s' % (self.dst, clone, out))
        # the same calibration matrix as KWin uses for the iptsd device. KWin's getter lists the 4x4 matrix column by
        # column, its setter (and kcminputrc) row by row; without a kcminputrc entry KWin round-trips libinput's
        # default through both and ends up with it transposed (the translations lost: taps above the screen)
        om, cm = matrix16(kwin_prop(orig, 'calibrationMatrix')), matrix16(kwin_prop(clone, 'calibrationMatrix'))
        if om is None or cm is None:
            return self.wait('the calibration matrix of %s / %s from KWin' % (orig, clone))
        if cm != om:
            kwin_prop(clone, 'calibrationMatrix', ','.join('%g' % om[c * 4 + r] for r in range(4) for c in range(4)))
            if matrix16(kwin_prop(clone, 'calibrationMatrix')) != om:
                return self.wait('KWin to take the calibration matrix of %s for %s' % (orig, clone))
            log('%s (%s): calibration matrix copied from %s' % (self.dst, clone, orig))
        en = kwin_prop(orig, 'enabled')
        if en in ('true', 'false') and kwin_prop(clone, 'enabled') != en:
            kwin_prop(clone, 'enabled', en == 'true')
        self.waiting = None
        return True

    def wait(self, what):
        if what != self.waiting:
            log('%s: waiting for %s' % (self.dst, what))
            self.waiting = what
        return False

    def fingers(self):
        buf = bytearray(struct.pack('I', ABS_MT_TRACKING_ID) + struct.pack('64i', *([-1] * 64)))
        try:
            fcntl.ioctl(self.fd, EVIOCGMTSLOTS_64, buf)
        except OSError:
            return 0
        return sum(1 for v in struct.unpack_from('64i', buf, 4) if v != -1)

    def grab(self):
        fcntl.ioctl(self.fd, EVIOCGRAB, 1)
        self.grabbed = True
        self.resync()

    def mtslots(self, code):
        buf = bytearray(struct.pack('I', code) + bytes(4 * 64))
        fcntl.ioctl(self.fd, EVIOCGMTSLOTS_64, buf)
        return struct.unpack_from('64i', buf, 4)

    def resync(self):
        """slot state from the iptsd device (after the grab or a SYN_DROPPED), and the clone told all of it"""
        try:
            tid, xs, ys = (self.mtslots(c) for c in (ABS_MT_TRACKING_ID, ABS_MT_POSITION_X, ABS_MT_POSITION_Y))
            buf = bytearray(24)
            fcntl.ioctl(self.fd, EVIOCGABS(ABS_MT_SLOT), buf)
            self.slot = struct.unpack('6i', buf)[0]
        except OSError:
            return
        gone = [s for s, v in self.slots.items() if v[0] != -1 and tid[s] == -1]
        self.slots = {s: [tid[s], xs[s], ys[s]] for s in range(64) if tid[s] != -1}
        self.frame, self.fslot, self.sent = [], None, {}
        out = []
        for s in gone:  # ended while events were dropped
            out += [(EV_ABS, ABS_MT_SLOT, s), (EV_ABS, ABS_MT_TRACKING_ID, -1)]
        for s, (t, x, y) in self.slots.items():
            fx, fy = self.correct(x, y)
            out += [(EV_ABS, ABS_MT_SLOT, s), (EV_ABS, ABS_MT_TRACKING_ID, t), (EV_ABS, ABS_MT_POSITION_X, fx),
                    (EV_ABS, ABS_MT_POSITION_Y, fy)]
            self.sent[s] = [fx, fy]
        out += [(EV_ABS, ABS_MT_SLOT, self.slot), (EV_SYN, SYN_REPORT, 0)]
        self.emit(out)

    def set_maps(self, screen, raw):
        """screen: {"x": pairs, "y": pairs} in output coordinates -> maps on this device's raw X / raw Y"""
        self.mx = self.my = Map()
        if raw or not screen:
            return
        try:
            a, b, c, d, e, f = (float(v) for v in self.matrix.split())
        except ValueError:
            a, b, c, d, e, f = 1, 0, 0, 0, 1, 0
        # output_x = a*nx + b*ny + c, output_y = d*nx + e*ny + f (nx, ny = raw 0..1); only axis-aligned matrices
        rows = (('x', a, b, c), ('y', d, e, f))
        maps = {}
        for out, p, q, r in rows:
            if abs(p) == 1 and q == 0:
                raw_axis, s = 'nx', p
            elif abs(q) == 1 and p == 0:
                raw_axis, s = 'ny', q
            else:
                log('%s: matrix %s is not axis-aligned, no correction' % (self.dst, self.matrix))
                return
            pairs = [((m - r) / s, (t - r) / s) for m, t in screen.get(out, [])]
            maps[raw_axis] = Map(pairs)
        self.mx, self.my = maps.get('nx', Map()), maps.get('ny', Map())

    def fix(self, code, v):
        m = self.mx if code in (ABS_X, ABS_MT_POSITION_X) else self.my
        if m.identity():
            return v
        _, lo, hi, _, _, _ = self.abs[code]
        if hi <= lo:
            return v
        return int(round(lo + m((v - lo) / (hi - lo)) * (hi - lo)))

    def edge_fix(self, x, y):
        """iptsd's raw (x, y) with the position along each axis replaced near a border (see the docstring)"""
        sig = self.heat.signal() if self.edge and self.heat else None
        if sig is None or self.maxx <= 0 or self.maxy <= 0:
            return x, y
        nc, nr = HM_COLS - 1, HM_ROWS - 1
        cf = nc * (1.0 - x / float(self.maxx))  # X grows towards column 0
        rf = nr * y / float(self.maxy)
        nx, ny, info = x, y, []
        # along the columns (the screen's top and bottom): profile over the rows next to the contact's
        side, u = (0, cf) if cf <= nc - cf else (1, nc - cf)
        if u < EDGE['near']:
            rows = range(max(1, int(round(rf)) - 1), min(nr - 1, int(round(rf)) + 1) + 1)
            prof = [0] + [sum(sig[j * HM_COLS + (k if side == 0 else nc - k)] for j in rows) for k in range(1, 8)]
            d = edge_est(prof, u, EDGE['r']['col'])
            if d is not None:
                nx = int(round(self.maxx * (1.0 - (d if side == 0 else nc - d) / nc)))
                info.append(('col', side, round(u, 2), round(d, 2)))
        # along the rows (the screen's sides)
        side, u = (0, rf) if rf <= nr - rf else (1, nr - rf)
        if u < EDGE['near']:
            cols = range(max(1, int(round(cf)) - 1), min(nc - 1, int(round(cf)) + 1) + 1)
            prof = [0] + [sum(sig[(k if side == 0 else nr - k) * HM_COLS + j] for j in cols) for k in range(1, 8)]
            d = edge_est(prof, u, EDGE['r']['row'])
            if d is not None:
                ny = int(round(self.maxy * (d if side == 0 else nr - d) / nr))
                info.append(('row', side, round(u, 2), round(d, 2)))
        if info and self.watch:
            self.watch({'screen': self.output, 'x': x, 'y': y, 'nx': nx, 'ny': ny, 'edge': info})
        return nx, ny

    def correct(self, x, y):
        x, y = self.edge_fix(x, y)
        return self.fix(ABS_MT_POSITION_X, x), self.fix(ABS_MT_POSITION_Y, y)

    def emit(self, events):
        if events and self.ui is not None:
            os.write(self.ui, b''.join(EVENT.pack(0, 0, t, c, v) for t, c, v in events))

    def forward(self):
        """iptsd's events, a frame (up to SYN_REPORT) at a time, with the positions corrected"""
        data = os.read(self.fd, EVENT.size * 128)
        for i in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, t, code, v = EVENT.unpack_from(data, i)
            if t == EV_SYN and code == SYN_DROPPED:
                self.resync()
                continue
            if t == EV_SYN and code == SYN_REPORT:
                self.flush()
                continue
            if self.fslot is None:
                self.fslot = self.slot
            self.frame.append((t, code, v))
            if t != EV_ABS:
                continue
            if code == ABS_MT_SLOT:
                self.slot = v
            elif code in (ABS_X, ABS_Y):
                self.st[code - ABS_X] = v
            elif code in (ABS_MT_TRACKING_ID, ABS_MT_POSITION_X, ABS_MT_POSITION_Y):
                s = self.slots.setdefault(self.slot, [-1, 0, 0])
                s[(ABS_MT_TRACKING_ID, ABS_MT_POSITION_X, ABS_MT_POSITION_Y).index(code)] = v

    def flush(self):
        if self.heat:
            self.heat.drain()
        fixed = {s: self.correct(x, y) for s, (t, x, y) in self.slots.items() if t != -1}
        out, slot, st = [], self.fslot if self.fslot is not None else self.slot, None
        for t, code, v in self.frame:
            if t == EV_ABS:
                if code == ABS_MT_SLOT:
                    slot = v
                elif code == ABS_MT_TRACKING_ID and v == -1:
                    self.sent.pop(slot, None)
                elif code in (ABS_MT_POSITION_X, ABS_MT_POSITION_Y) and slot in fixed:
                    i = 0 if code == ABS_MT_POSITION_X else 1
                    v = fixed[slot][i]
                    self.sent.setdefault(slot, [None, None])[i] = v
                elif code in (ABS_X, ABS_Y):  # the single-touch copy of one contact: the pair, as the MT ones
                    if st is None:
                        st = self.correct(*self.st)
                    v = st[code - ABS_X]
            out.append((t, code, v))
        # contacts iptsd did not move this frame, but whose estimate did (iptsd stuck at the border)
        moved = False
        for s, f in fixed.items():
            if self.sent.get(s) != list(f):
                out += [(EV_ABS, ABS_MT_SLOT, s), (EV_ABS, ABS_MT_POSITION_X, f[0]), (EV_ABS, ABS_MT_POSITION_Y, f[1])]
                self.sent[s] = list(f)
                moved = True
        if moved:
            out.append((EV_ABS, ABS_MT_SLOT, self.slot))
        for s in [s for s, v in self.slots.items() if v[0] == -1]:
            del self.slots[s]
        out.append((EV_SYN, SYN_REPORT, 0))
        self.emit(out)
        self.frame, self.fslot = [], None

    def close(self):
        if self.heat:
            self.heat.close()
            self.heat = None
        if self.grabbed:
            try:
                fcntl.ioctl(self.fd, EVIOCGRAB, 0)
            except OSError:
                pass
        if self.ui is not None:
            try:
                fcntl.ioctl(self.ui, UI_DEV_DESTROY)
            except OSError:
                pass
            os.close(self.ui)
        os.close(self.fd)


def load_conf():
    try:
        with open(CONF) as f:
            c = json.load(f)
        return c.get('screens', {}) if isinstance(c, dict) else {}
    except (OSError, ValueError):
        return {}


def save_conf(screens):
    os.makedirs(os.path.dirname(CONF), exist_ok=True)
    tmp = CONF + '.new'
    with open(tmp, 'w') as f:
        json.dump({'version': 1, 'screens': screens}, f, indent=1)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, CONF)
    os.sync()


def write_rules(devs):
    os.makedirs(os.path.dirname(RULES), exist_ok=True)
    lines = ['# duo-touch-fix: the corrected touchscreens get their screen and matrix like the iptsd ones']
    for d in devs:
        lines.append('SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="%s", ENV{WL_OUTPUT}="%s", '
                     'ENV{LIBINPUT_CALIBRATION_MATRIX}="%s"' % (d.dst, d.output, d.matrix))
    with open(RULES + '.new', 'w') as f:
        f.write('\n'.join(lines) + '\n')
    os.replace(RULES + '.new', RULES)
    subprocess.run(['udevadm', 'control', '--reload'])


def scan(devs, pending):
    """new iptsd touchscreens -> Dev objects (not yet created / grabbed); returns how many were added"""
    have = {d.node for d in devs} | {d.node for d in pending}
    n = 0
    for p in sorted(glob.glob('/sys/class/input/event*/device/name')):
        try:
            name = open(p).read().strip()
        except OSError:
            continue
        node = '/dev/input/' + p.split('/')[4]
        if not name.startswith(SRC) or node in have:
            continue
        pr = udev_props(node)
        if not pr.get('WL_OUTPUT'):
            continue  # duo-hw writes its rule right after iptsd starts: next round
        try:
            pending.append(Dev(node, name, pr['WL_OUTPUT'], pr.get('LIBINPUT_CALIBRATION_MATRIX', '1 0 0 0 1 0')))
            log('found %s (%s) on %s' % (node, name, pr['WL_OUTPUT']))
            n += 1
        except OSError as e:
            log('%s: %s' % (node, e))
    return n


def main():
    devs, pending, clients = [], [], {}
    screens = load_conf()
    log('calibration: %s' % (', '.join(sorted(screens)) or 'none'))

    def raw():
        return any(c['raw'] for c in clients.values())

    def apply_maps():
        r = raw()
        for d in devs:
            d.set_maps(screens.get(d.output), r)

    def watch(info):
        line = (json.dumps(info) + '\n').encode()
        for c, st in list(clients.items()):
            if st.get('watch'):
                try:
                    c.send(line, socket.MSG_DONTWAIT)
                except OSError:
                    st['watch'] = False
        if not any(st.get('watch') for st in clients.values()):
            for d in devs:
                d.watch = None

    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o666)  # the calibration app runs as the desktop user
    srv.listen(4)
    next_scan = 0.0
    while True:
        now = time.monotonic()
        if now >= next_scan:
            next_scan = now + 2.0
            for d in [d for d in devs if not os.path.exists(d.node)]:
                log('%s gone' % d.node)
                devs.remove(d)
                d.close()
            if scan(devs, pending):
                write_rules(devs + pending)  # before the clones exist, so libinput sees WL_OUTPUT at once
            for d in list(pending):
                try:
                    if d.ui is None:
                        d.create()
                        log('created %s for %s' % (d.dst, d.output))
                        continue  # give udev/KWin a round to add the clone before the grab
                    if not d.kwin_ready():
                        continue  # until then the iptsd device stays in use, uncorrected
                    if d.fingers():
                        continue  # never grab under a finger: KWin would keep that touch forever
                    d.grab()
                    pending.remove(d)
                    devs.append(d)
                    d.set_maps(screens.get(d.output), raw())
                    log('%s now corrected (%s, edges %s)' % (d.dst, 'calibrated' if d.output in screens else
                                                              'no calibration', 'from ' + d.heat.path if d.heat else
                                                              'as iptsd has them: no heatmap'))
                except OSError as e:
                    log('%s: %s' % (d.node, e))
                    pending.remove(d)
                    d.close()
        rl = [srv] + [d.fd for d in devs] + list(clients)
        try:
            ready, _, _ = select.select(rl, [], [], max(0.0, next_scan - time.monotonic()))
        except InterruptedError:
            continue
        for fd in ready:
            if fd is srv:
                c, _ = srv.accept()
                clients[c] = {'raw': False, 'watch': False, 'buf': b''}
                continue
            if fd in clients:
                st = clients[fd]
                try:
                    chunk = fd.recv(65536)
                except OSError:
                    chunk = b''
                if not chunk:
                    del clients[fd]
                    fd.close()
                    if st['raw']:
                        apply_maps()
                        log('raw mode ended (client gone)')
                    continue
                st['buf'] += chunk
                while b'\n' in st['buf']:
                    line, st['buf'] = st['buf'].split(b'\n', 1)
                    try:
                        req = json.loads(line)
                        cmd = req.get('cmd')
                    except (ValueError, AttributeError):
                        req, cmd = {}, None
                    reply = {'ok': True}
                    if cmd == 'raw':
                        st['raw'] = True
                        apply_maps()
                        log('raw mode (calibration)')
                    elif cmd == 'normal':
                        st['raw'] = False
                        apply_maps()
                        log('raw mode ended')
                    elif cmd == 'save' and isinstance(req.get('screens'), dict):
                        for k, v in req['screens'].items():
                            if isinstance(v, dict):
                                screens[str(k)] = {a: [[float(m), float(t)] for m, t in v.get(a, [])] for a in 'xy'}
                        save_conf(screens)
                        apply_maps()
                        log('saved calibration for %s' % ', '.join(sorted(req['screens'])))
                    elif cmd == 'reset':
                        for k in (req.get('screens') or list(screens)):
                            screens.pop(k, None)
                        save_conf(screens)
                        apply_maps()
                        log('calibration reset: %s' % (', '.join(sorted(screens)) or 'none left'))
                    elif cmd == 'edge':
                        for d in devs:
                            d.edge = bool(req.get('on', True)) and d.heat is not None
                        log('edge estimate %s' % ('on' if req.get('on', True) else 'off'))
                    elif cmd == 'watch':
                        st['watch'] = True
                        for d in devs:
                            d.watch = watch
                    elif cmd == 'status':
                        reply.update(screens=screens, raw=raw(),
                                     devices=[{'node': d.node, 'name': d.dst, 'output': d.output, 'edge': d.edge,
                                               'heatmap': d.heat.path if d.heat else None,
                                               'report_id': d.heat.rid if d.heat else None} for d in devs])
                    else:
                        reply = {'ok': False, 'error': 'unknown command'}
                    try:
                        fd.sendall((json.dumps(reply) + '\n').encode())
                    except OSError:
                        pass
                continue
            d = next((d for d in devs if d.fd == fd), None)
            if d is None:
                continue
            try:
                d.forward()
            except BlockingIOError:
                pass
            except OSError as e:
                log('%s: %s, dropped' % (d.node, e))
                devs.remove(d)
                d.close()


if __name__ == '__main__':
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        pass
