#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Surface Duo posture (Debian/Plasma, 2026-11-19): follow the hinge like Android does.
#   closed (hinge < 10 deg)          -> both panels off, touch off
#   folded back (hinge > 330 deg)    -> one screen: DSI-2 (the camera side) stays, DSI-1 + its touch off
#   anything else                    -> both screens
# Runs in the Plasma session (autostart org.duo.Posture.desktop): kscreen-doctor and KWin's input devices need the
# user's Wayland/D-Bus session. The hinge angle comes from the sensor DSP (duo-hinge, libssc). Hysteresis: 10/20 and
# 330/310 deg. Log: $XDG_RUNTIME_DIR/duo-posture.log. Off: touch ~/.config/duo-posture-off
H=/usr/libexec/duo/duo-hinge
LOG=${XDG_RUNTIME_DIR:-/tmp}/duo-posture.log
log() { echo "$(date +%T) $*" >> "$LOG"; }
[ -f "$HOME/.config/duo-posture-off" ] && { log "off (~/.config/duo-posture-off)"; exit 0; }

# KWin input device (D-Bus object path) by name; enabled true|false
touch_dev() {
	for p in $(busctl --user --list tree org.kde.KWin 2>/dev/null | grep '/org/kde/KWin/InputDevice/'); do
		busctl --user get-property org.kde.KWin "$p" org.kde.KWin.InputDevice name 2>/dev/null | grep -q "$1" && echo "$p"
	done
}
touch_set() { # <name pattern> <true|false>
	for p in $(touch_dev "$1"); do busctl --user set-property org.kde.KWin "$p" org.kde.KWin.InputDevice enabled b "$2"; done
}
RIGHT='Touchscreen 045E:0C01'   # DSI-2 (camera side)
LEFT='Touchscreen 045E:0C02'    # DSI-1

apply() {
	case $1 in
	closed) kscreen-doctor --dpms off > /dev/null 2>&1; touch_set "$RIGHT" false; touch_set "$LEFT" false ;;
	single) kscreen-doctor --dpms on > /dev/null 2>&1
		kscreen-doctor output.DSI-2.enable output.DSI-1.disable > /dev/null 2>&1
		touch_set "$LEFT" false; touch_set "$RIGHT" true ;;
	dual)   kscreen-doctor --dpms on > /dev/null 2>&1
		kscreen-doctor output.DSI-1.enable output.DSI-2.enable output.DSI-1.position.0,0 output.DSI-2.position.563,0 > /dev/null 2>&1
		touch_set "$RIGHT" true; touch_set "$LEFT" true ;;
	esac
	log "posture $1 (hinge $2 deg)"
}

state=
while :; do
	"$H" hinge_angle 2>> "$LOG" | while read -r a rest; do
		a=${a%%.*}; case $a in ''|*[!0-9-]*) continue ;; esac
		new=$state
		case $state in
		closed) [ "$a" -gt 20 ] && new=dual ;;
		single) [ "$a" -lt 310 ] && new=dual ;;
		*)      new=dual ;;
		esac
		[ "$a" -lt 10 ] && new=closed
		[ "$a" -gt 330 ] && new=single
		[ "$new" != "$state" ] && { apply "$new" "$a"; state=$new; }
	done
	log "duo-hinge ended, restarting in 5 s"; sleep 5
done
