#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Surface Duo in-call audio (2026-11-20). README: "Dźwięk rozmowy (q6voice)".

Holding the q6voice VoiceMMode1 PCM open in both directions starts the ADSP voice path (mics -> vocproc -> modem ->
vocproc -> earpiece); no audio data passes through it. ModemManager has no audio policy, so this daemon follows its
calls: ringing-in/dialing -> add the earpiece path on the codec (speaker kept for the ringtone); active (and
ringing-out) -> the speaker path to -84 dB, open and start the voice PCM; no call left -> close it, restore the speaker.
While an incoming call rings (and no other call is up) it also plays the ringtone in a loop, vibrates (hfd-service)
and wakes the screens (duo-wake): the dialer itself only plays its notification sound once and neither vibrates nor
wakes the screens.
Speaker and mute follow Plasma Dialer's buttons (kde-telephony-daemon's org.kde.telephony.DialerUtils signals
speakerModeChanged / muteChanged on the session bus; callaudiod, which the dialer also asks, has no call profile for
this card): speaker = the loudspeaker path (RX INT7) instead of the earpiece (RX INT0) and the speakerphone mic, mute =
DEC7 at its minimum. Every call starts on the earpiece, unmuted (both buttons are reset at the end of a call).
Plasma Dialer 6.3's call page cannot read the buttons' state back (CallPage.qml: "Cannot assign [undefined] to bool"),
so every press sends setSpeakerMode(true) / setMute(true), never false; a true while that state is already on is
therefore taken as the second press: this daemon sends the false to kde-telephony-daemon itself.
Call volume: during a call the speaker sink's volume (slider, volume keys) is the call volume; it starts at the last
call's volume (/var/lib/duo/call-volume) and the media volume comes back after the call.
The codec must be routed to the earpiece a while before the voice start (else the downlink stays deaf until a
re-open), routes change only with PipeWire's sink/source suspended, the TX topology is NONE (SM_ECNS needs ACDB
calibration). Settings: /etc/default/duo-call-audio (DUO_CALL_* environment variables below).
"""
import ctypes, json, math, os, pwd, re, select, shutil, signal, subprocess, sys, time

CARD = os.environ.get('DUO_CALL_CARD', 'SurfaceDuo')
VOICE_PCM = os.environ.get('DUO_CALL_PCM', 'VoiceMMode1')
SINK = os.environ.get('DUO_CALL_SINK', 'alsa_output.platform-sound.HiFi__Speaker__sink')
SOURCE = os.environ.get('DUO_CALL_SOURCE', 'alsa_input.platform-sound.HiFi__Mic__source')
EAR_RX0_VOLUME = int(os.environ.get('DUO_CALL_EAR_VOLUME', '84'))  # RX0 digital volume, 84 = 0 dB
EAR_PA = int(os.environ.get('DUO_CALL_EAR_PA', '4'))  # EAR PA Volume, 4 = +6 dB (Android handset)
# the call microphone (DMIC MUX7 -> DEC7 -> TX7 = the vocproc's mic): DMIC1 = bottom of the right half (Android's
# handset mic); DMIC2 and DMIC3 read one mic at the top of the left half (two edges of one data line); DMIC0/4/5 unused
CALL_DMIC = os.environ.get('DUO_CALL_DMIC', 'DMIC1')
# DEC7 Volume during calls (84 = 0 dB): 98 = +14 dB, the best of 66..114 in two test calls (2026-11-20)
MIC_VOLUME = os.environ.get('DUO_CALL_MIC_VOLUME', '98')
MIC_BOOST_DB = int(os.environ.get('DUO_CALL_MIC_BOOST', '6'))  # with DUO_CALL_MIC_VOLUME empty: added to DEC7
# open the voice path already while an outgoing call rings (network ringback tone) instead of at answer
OPEN_ON_RINGING_OUT = os.environ.get('DUO_CALL_OPEN_RINGING_OUT', '1') == '1'
# the incoming call: ringtone (looped; empty = none), vibration, screen wake
RINGTONE = os.environ.get('DUO_CALL_RINGTONE', '/usr/share/sounds/ocean/stereo/phone-incoming-call.oga')
VIBRATE = os.environ.get('DUO_CALL_VIBRATE', '1') == '1'
WAKE = os.environ.get('DUO_CALL_WAKE', '1') == '1'
RING_GRACE = 2.5  # keep ringing this long when the ringing Call object vanishes (a new one often follows)
# speakerphone: RX7 digital volume at the default call volume (84 = 0 dB; HiFi music uses 104), its mic and mic level
SPK_RX7_VOLUME = int(os.environ.get('DUO_CALL_SPK_VOLUME', '94'))
SPK_DMIC = os.environ.get('DUO_CALL_SPK_DMIC', 'DMIC1')
SPK_MIC_VOLUME = os.environ.get('DUO_CALL_SPK_MIC_VOLUME', '') or MIC_VOLUME
# 1 = close and reopen the voice PCM after an earpiece <-> speaker switch (if the switch leaves the path silent)
SWITCH_REOPEN = os.environ.get('DUO_CALL_SWITCH_REOPEN', '0') == '1'
# call volume (%, as the sink volume shows it) at which the earpiece/speaker get the levels above; cubic like PipeWire
CALL_VOLUME_DEFAULT = int(os.environ.get('DUO_CALL_VOLUME', '80'))
VOLUME_FILE = '/var/lib/duo/call-volume'
TX_TOPOLOGY_NONE = 0x10F70
UNANSWERED_GRACE = 6.0  # the first incoming Call object often vanishes 1-3 s after ringing; a new one follows

# MMCallState
DIALING, RINGING_OUT, RINGING_IN, ACTIVE, HELD, WAITING, TERMINATED = 1, 2, 3, 4, 5, 6, 7
STATE_NAMES = {'unknown': 0, 'dialing': DIALING, 'ringing-out': RINGING_OUT, 'ringing-in': RINGING_IN,
               'active': ACTIVE, 'held': HELD, 'waiting': WAITING, 'terminated': TERMINATED}


def log(msg):
    print(msg, flush=True)
    try:
        with open('/dev/kmsg', 'w') as k:
            k.write('duo-call-audio: %s\n' % msg)
    except OSError:
        pass


# --- mixer ---
def amixer(args):
    r = subprocess.run(['amixer', '-c', CARD] + args, capture_output=True, text=True)
    if r.returncode:
        log('amixer %s failed: %s' % (' '.join(args), r.stderr.strip()))
    return r.stdout


def cset(pairs):
    for n, v in pairs:  # one amixer per control: amixer -s (stdin) prints nothing for cget
        amixer(['-q', 'cset', 'name=%s' % n, str(v)])


def cget(names):
    """Current values (as amixer prints them: numbers, enum items by index) of the named controls."""
    vals = {}
    for n in names:
        m = re.search(r'^\s*: values=(\S+)', amixer(['cget', 'name=%s' % n]), re.M)
        if m:
            vals[n] = m.group(1)
    return vals


# --- PipeWire ---
def session_user():
    for d in sorted(os.listdir('/run/user')) if os.path.isdir('/run/user') else []:
        if os.path.exists('/run/user/%s/pulse/native' % d) or os.path.exists('/run/user/%s/pipewire-0' % d):
            try:
                return pwd.getpwuid(int(d))
            except (KeyError, ValueError):
                pass
    return None


def suspend(on):
    """Suspend (on=True) or resume PipeWire's speaker sink and mic source, both at once."""
    u = session_user()
    if not u:
        return
    env = {'XDG_RUNTIME_DIR': '/run/user/%d' % u.pw_uid, 'PATH': '/usr/bin:/bin', 'HOME': u.pw_dir}
    procs = [subprocess.Popen(['pactl', cmd, name, '1' if on else '0'], user=u.pw_uid, group=u.pw_gid, env=env,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
             for cmd, name in (('suspend-sink', SINK), ('suspend-source', SOURCE))]
    for p in procs:
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            p.kill()


def user_env(u):
    return {'XDG_RUNTIME_DIR': '/run/user/%d' % u.pw_uid, 'PATH': '/usr/bin:/bin', 'HOME': u.pw_dir,
            'DBUS_SESSION_BUS_ADDRESS': 'unix:path=/run/user/%d/bus' % u.pw_uid}


def as_user(args, timeout=5):
    """Run a command as the session's user; its stdout, or None."""
    u = session_user()
    if not u:
        return None
    try:
        r = subprocess.run(args, user=u.pw_uid, group=u.pw_gid, env=user_env(u), capture_output=True, text=True,
                           timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def sink_volume():
    out = as_user(['pactl', 'get-sink-volume', SINK]) or ''
    m = re.search(r'(\d+)%', out)
    return int(m.group(1)) if m else None


def set_sink_volume(pct):
    as_user(['pactl', 'set-sink-volume', SINK, '%d%%' % pct])


def level(base, pct):
    """Codec digital volume (1 dB steps, 84 = 0 dB) for the call volume pct: base at CALL_VOLUME_DEFAULT, cubic."""
    if pct <= 0:
        return 0
    return max(0, min(124, base + round(60 * math.log10(pct / CALL_VOLUME_DEFAULT))))


def dialer_set(method, value):
    """setSpeakerMode / setMute of kde-telephony-daemon (it answers with speakerModeChanged / muteChanged)"""
    as_user(['busctl', '--user', 'call', 'org.kde.telephony.DialerUtils', '/org/kde/telephony/DialerUtils/tel/mm',
             'org.kde.telephony.DialerUtils', method, 'b', 'true' if value else 'false'])


def dialer_reset():
    """Speaker and mute buttons off again (the next call starts on the earpiece, unmuted)."""
    for method in ('setSpeakerMode', 'setMute'):
        dialer_set(method, False)


class DialerWatch:
    """speakerModeChanged / muteChanged of kde-telephony-daemon and the setSpeakerMode / setMute calls it gets
    (session bus) as a pipe of JSON lines"""
    def __init__(self):
        self.proc, self.buf, self.next_try = None, b'', 0.0

    def fileno(self):
        return self.proc.stdout.fileno()

    def ensure(self):
        if self.proc and self.proc.poll() is None:
            return True
        if time.monotonic() < self.next_try:
            return False
        self.next_try = time.monotonic() + 10
        u = session_user()
        if not u or not os.path.exists('/run/user/%d/bus' % u.pw_uid):
            self.proc = None
            return False
        self.proc = subprocess.Popen(['busctl', '--user', 'monitor', '--json=short', '--match',
                                      "type='signal',interface='org.kde.telephony.DialerUtils'", '--match',
                                      "type='method_call',interface='org.kde.telephony.DialerUtils',member='setSpeakerMode'",
                                      '--match',
                                      "type='method_call',interface='org.kde.telephony.DialerUtils',member='setMute'"],
                                     user=u.pw_uid, group=u.pw_gid, env=user_env(u), stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, bufsize=0)
        self.buf = b''
        return True

    def read(self):
        """[(member, bool)] from what is waiting on the pipe"""
        data = os.read(self.fileno(), 65536)
        if not data:
            self.proc.wait()
            self.proc = None
            return []
        self.buf += data
        *lines, self.buf = self.buf.split(b'\n')
        out = []
        for line in lines:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            d = (m.get('payload') or {}).get('data') or []
            if m.get('member') in ('speakerModeChanged', 'muteChanged', 'setSpeakerMode', 'setMute') and d \
                    and isinstance(d[0], bool):
                out.append((m['member'], d[0]))
        return out


# --- voice PCM ---
class VoicePcm:
    def __init__(self):
        a = self.a = ctypes.CDLL('libasound.so.2')
        VP, UL = ctypes.c_void_p, ctypes.c_ulong
        a.snd_strerror.restype = ctypes.c_char_p
        a.snd_pcm_open.argtypes = [ctypes.POINTER(VP), ctypes.c_char_p, ctypes.c_int, ctypes.c_int]
        a.snd_pcm_set_params.argtypes = [VP, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint, ctypes.c_int,
                                         ctypes.c_uint]
        a.snd_pcm_sw_params_malloc.argtypes = [ctypes.POINTER(VP)]
        a.snd_pcm_sw_params_current.argtypes = [VP, VP]
        a.snd_pcm_sw_params_get_boundary.argtypes = [VP, ctypes.POINTER(UL)]
        a.snd_pcm_sw_params_set_stop_threshold.argtypes = [VP, VP, UL]
        a.snd_pcm_sw_params.argtypes = [VP, VP]
        a.snd_pcm_sw_params_free.argtypes = [VP]
        a.snd_pcm_start.argtypes = [VP]
        a.snd_pcm_close.argtypes = [VP]
        self.VP, self.UL, self.pcms = VP, UL, []

    @staticmethod
    def device():
        try:
            with open('/proc/asound/pcm') as f:
                for line in f:
                    m = re.match(r'(\d+)-(\d+): %s ' % re.escape(VOICE_PCM), line)
                    if m:
                        return 'hw:%s,%d' % (CARD, int(m.group(2)))
        except OSError:
            pass
        return None

    def open(self):
        a, dev = self.a, self.device()
        if not dev:
            log('no %s PCM (q6voice modules not loaded?)' % VOICE_PCM)
            return False
        for stream in (0, 1):  # playback (RX) and capture (TX): the ADSP starts the path when both are open
            p = self.VP()
            r = a.snd_pcm_open(ctypes.byref(p), dev.encode(), stream, 0)
            if r < 0:
                log('open %s stream %d: %s' % (dev, stream, a.snd_strerror(r).decode()))
                self.close()
                return False
            self.pcms.append(p)
            r = a.snd_pcm_set_params(p, 2, 3, 1, 8000, 0, 500000)  # S16_LE, interleaved, mono, 8 kHz (prepares)
            sw, bnd = self.VP(), self.UL()
            a.snd_pcm_sw_params_malloc(ctypes.byref(sw))
            a.snd_pcm_sw_params_current(p, sw)
            a.snd_pcm_sw_params_get_boundary(sw, ctypes.byref(bnd))
            a.snd_pcm_sw_params_set_stop_threshold(p, sw, bnd)
            a.snd_pcm_sw_params(p, sw)
            a.snd_pcm_sw_params_free(sw)
            if r < 0:
                log('set_params %s stream %d: %s' % (dev, stream, a.snd_strerror(r).decode()))
                self.close()
                return False
        for p in self.pcms:
            r = a.snd_pcm_start(p)
            if r < 0:
                log('start %s: %s' % (dev, a.snd_strerror(r).decode()))
        log('voice path on (%s)' % dev)
        return True

    def close(self):
        for p in self.pcms:
            self.a.snd_pcm_close(p)
        if self.pcms:
            log('voice path off')
        self.pcms = []

    @property
    def is_open(self):
        return bool(self.pcms)


# --- routing ---
SAVED_CONTROLS = ['RX INT0_1 MIX1 INP0', 'RX INT0 DEM MUX', 'RX INT7_1 MIX1 INP0', 'EAR PA Volume',
                  'RX0 Digital Volume', 'RX7 Digital Volume', 'DEC7 Volume', 'DMIC MUX7']


class CallAudio:
    def __init__(self):
        self.pcm = VoicePcm()
        self.mode = 'idle'  # idle | pre | voice
        self.saved = {}
        self.speaker = False  # the dialer's Speaker button
        self.muted = False  # its Mute button
        self.out = None  # in voice mode: 'spk' or 'ear' as routed
        self.media_volume = None
        try:
            self.volume = max(1, min(150, int(open(VOLUME_FILE).read().strip())))
        except (OSError, ValueError):
            self.volume = CALL_VOLUME_DEFAULT

    def mic_pairs(self, speaker):
        dmic, vol = (SPK_DMIC, SPK_MIC_VOLUME) if speaker else (CALL_DMIC, MIC_VOLUME)
        pairs = [('DMIC MUX7', dmic)] if dmic else []
        if self.muted:
            pairs.append(('DEC7 Volume', 0))
        elif vol:
            pairs.append(('DEC7 Volume', int(vol)))
        else:
            dec7 = self.saved.get('DEC7 Volume')
            if dec7 and dec7.lstrip('-').isdigit():
                pairs.append(('DEC7 Volume', min(int(dec7) + MIC_BOOST_DB, 124)))
        return pairs

    def out_pairs(self, speaker):
        """Both paths stay routed during a call (earpiece RX INT0, loudspeaker RX INT7 -> SpkrLeft as the HiFi profile
        set it up); the switch only moves the digital volumes (0 = -84 dB = off). A route change while the voice PCM
        runs could leave the path silent until a re-open, a volume change cannot."""
        ear = level(EAR_RX0_VOLUME, self.volume) if not speaker else 0
        spk = level(SPK_RX7_VOLUME, self.volume) if speaker else 0
        return [('RX INT0_1 MIX1 INP0', 'RX0'), ('RX INT7_1 MIX1 INP0', 'RX0'),
                ('RX0 Digital Volume', ear), ('RX7 Digital Volume', spk)]

    def set_speaker(self, on):
        self.speaker = on
        want = 'spk' if on else 'ear'
        if self.mode != 'voice' or self.out == want:
            log('speaker %s (applied when the call is up)' % ('on' if on else 'off'))
            return
        suspend(True)
        cset(self.out_pairs(on) + self.mic_pairs(on))
        suspend(False)
        self.out = want
        if SWITCH_REOPEN:
            self.pcm.close()
            time.sleep(2.5)
            self.pcm.open()
        log('in-call output: %s' % ('speaker' if on else 'earpiece'))

    def set_mute(self, on):
        self.muted = on
        if self.mode != 'idle':
            cset([p for p in self.mic_pairs(self.out == 'spk') if p[0] == 'DEC7 Volume'])
        log('microphone %s' % ('muted' if on else 'on'))

    def follow_volume(self):
        """the sink volume is the call volume while the voice path is up"""
        v = sink_volume()
        if v is None or v == self.volume:
            return
        self.volume = v
        cset([p for p in self.out_pairs(self.out == 'spk') if p[0] == ('RX7 Digital Volume' if self.out == 'spk'
                                                                        else 'RX0 Digital Volume')])
        log('call volume %d %%' % v)

    def preroute(self):
        """Earpiece path on, speaker path kept (a ringtone may be playing): done while the call still rings."""
        suspend(True)
        self.saved = cget(SAVED_CONTROLS)
        pairs = [('SLIMBUS_0_RX Voice Mixer %s' % VOICE_PCM, 1), ('%s Capture Mixer SLIMBUS_0_TX' % VOICE_PCM, 1),
                 ('%s TX Topology' % VOICE_PCM, TX_TOPOLOGY_NONE),
                 ('RX INT0_1 MIX1 INP0', 'RX0'), ('RX INT0 DEM MUX', 'CLSH_DSM_OUT'),
                 ('EAR PA Volume', EAR_PA), ('RX0 Digital Volume', level(EAR_RX0_VOLUME, self.volume))]
        cset(pairs + self.mic_pairs(False))
        suspend(False)
        self.pre_time = time.monotonic()
        self.mode = 'pre'
        log('earpiece routed')

    def voice_on(self):
        if self.mode == 'idle':
            self.preroute()
        # the codec needs a moment between the earpiece switch and the voice start (else the downlink stays deaf)
        wait = 2.5 - (time.monotonic() - self.pre_time)
        suspend(True)
        # both paths stay routed (the loudspeaker one is on for the ringtone); the unused one goes to -84 dB
        cset(self.out_pairs(self.speaker) + self.mic_pairs(self.speaker))
        if wait > 0:
            time.sleep(wait)
        if self.pcm.open():
            self.mode = 'voice'
            self.out = 'spk' if self.speaker else 'ear'
            if self.media_volume is None:  # the slider shows the call volume during the call
                self.media_volume = sink_volume()
                if self.media_volume is not None:
                    set_sink_volume(self.volume)
            return True
        return False

    def restore(self):
        self.pcm.close()
        if self.media_volume is not None:  # the media volume back, the call volume kept for the next call
            set_sink_volume(self.media_volume)
            self.media_volume = None
            try:
                os.makedirs(os.path.dirname(VOLUME_FILE), exist_ok=True)
                with open(VOLUME_FILE, 'w') as f:
                    f.write('%d\n' % self.volume)
            except OSError:
                pass
        if self.speaker or self.muted:
            dialer_reset()
        self.speaker = self.muted = False
        self.out = None
        suspend(True)
        pairs = [('SLIMBUS_0_RX Voice Mixer %s' % VOICE_PCM, 0), ('%s Capture Mixer SLIMBUS_0_TX' % VOICE_PCM, 0)]
        for name in SAVED_CONTROLS:
            v = self.saved.get(name)
            if v is not None:
                pairs.append((name, v))
        if not self.saved:  # the defaults of the HiFi profile
            pairs += [('RX INT0_1 MIX1 INP0', 'ZERO'), ('RX INT7_1 MIX1 INP0', 'RX0')]
        cset(pairs)
        suspend(False)
        self.mode = 'idle'
        log('speaker routed back')


# --- ringing ---
class Ringer:
    """Ringtone loop (as the session's user, PipeWire's default sink), vibration loop and one screen wake."""
    def __init__(self):
        self.procs = []
        self.off_since = None

    @property
    def on(self):
        return bool(self.procs)

    def start(self):
        self.off_since = None
        if self.procs:
            return
        if WAKE and os.path.exists('/usr/libexec/duo/duo-wake'):
            subprocess.Popen(['/usr/libexec/duo/duo-wake', 'incoming call'], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL)
        u = session_user()
        player = shutil.which('paplay') or shutil.which('pw-play')
        if u and RINGTONE and player and os.path.exists(RINGTONE):
            env = {'XDG_RUNTIME_DIR': '/run/user/%d' % u.pw_uid, 'PATH': '/usr/bin:/bin', 'HOME': u.pw_dir}
            self.procs.append(subprocess.Popen(['sh', '-c', 'while :; do "$0" "$1"; sleep 1; done', player, RINGTONE],
                                               user=u.pw_uid, group=u.pw_gid, env=env, start_new_session=True,
                                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        if VIBRATE:
            self.procs.append(subprocess.Popen(
                ['sh', '-c', 'while :; do busctl call com.lomiri.hfd /com/lomiri/hfd com.lomiri.hfd.Vibrator vibrate '
                 'i 1000; sleep 2; done'], start_new_session=True, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL))
        log('ringing (ringtone %s, vibration %s)' % ('on' if len(self.procs) > VIBRATE else 'off', VIBRATE))

    def stop(self):
        self.off_since = None
        for p in self.procs:
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            p.wait()
        if self.procs:
            log('ringing stopped')
        self.procs = []


def ringing(calls):
    states = {s for s, _ in calls.values()}
    return RINGING_IN in states and not states & {ACTIVE, HELD, DIALING, RINGING_OUT}


# --- ModemManager ---
def list_calls():
    """{call path: (state, direction)} from mmcli."""
    calls = {}
    r = subprocess.run(['mmcli', '-m', 'any', '--voice-list-calls', '-K'], capture_output=True, text=True)
    for path in re.findall(r'/org/freedesktop/ModemManager1/Call/\d+', r.stdout):
        o = subprocess.run(['mmcli', '-o', path, '-K'], capture_output=True, text=True).stdout
        st = re.search(r'call\.properties\.state\s*:\s*(\S+)', o)
        di = re.search(r'call\.properties\.direction\s*:\s*(\S+)', o)
        if st:
            calls[path] = (STATE_NAMES.get(st.group(1), 0), di.group(1) if di else '')
    return calls


def wanted(calls):
    states = {s for s, _ in calls.values()}
    if states & {ACTIVE, HELD} or (OPEN_ON_RINGING_OUT and RINGING_OUT in states):
        return 'voice'
    if states & {DIALING, RINGING_OUT, RINGING_IN, WAITING}:
        return 'pre'
    return 'idle'


STATE_CHANGED = re.compile(r'(/org/freedesktop/ModemManager1/Call/\d+): \S*Call\.StateChanged \((-?\d+), (-?\d+)')
CALL_PROPS = re.compile(r'(/org/freedesktop/ModemManager1/Call/\d+): org\.freedesktop\.DBus\.Properties\.PropertiesChanged')


def handle(line, calls):
    """Apply one gdbus monitor line to calls; True if the call list has to be read again."""
    m = STATE_CHANGED.match(line)
    if m and m.group(1) in calls:  # fast path: the new state straight from the signal
        calls[m.group(1)] = (int(m.group(3)), calls[m.group(1)][1])
        return False
    m = CALL_PROPS.match(line)
    if m and m.group(1) in calls:  # the same state change again, as a property
        return False
    return 'Call' in line  # CallAdded / CallDeleted / a call we do not know yet


def monitor():
    return subprocess.Popen(['gdbus', 'monitor', '--system', '--dest', 'org.freedesktop.ModemManager1'],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)


def main():
    ca, ringer, stop, dw = CallAudio(), Ringer(), [], DialerWatch()
    signal.signal(signal.SIGTERM, lambda *x: stop.append(1))
    signal.signal(signal.SIGINT, lambda *x: stop.append(1))
    try:
        mon = monitor()
    except FileNotFoundError:
        mon = None
        log('gdbus not found: polling ModemManager every second')
    calls, idle_since, refresh, retry_at, buf, listed = {}, None, True, 0.0, b'', 0.0
    log('watching calls (voice path at ringing-out: %s)' % OPEN_ON_RINGING_OUT)
    while not stop:
        # periodic check of the call list, in case a signal was missed
        period = 1.0 if mon is None or ringer.on else (5.0 if ca.mode != 'idle' else 30.0)
        timeout = min(period, 0.5) if ca.mode == 'voice' else period  # in a call: follow the volume
        watch = [dw] if dw.ensure() else []
        ready = select.select(watch + ([mon.stdout] if mon is not None else []), [], [], timeout)[0]
        if dw in ready:
            for member, value in dw.read():
                if member == 'speakerModeChanged':
                    ca.set_speaker(value)
                elif member == 'muteChanged':
                    ca.set_mute(value)
                elif value and (ca.speaker if member == 'setSpeakerMode' else ca.muted):
                    # the dialer's second press (it only ever sends true): switch it off through the daemon
                    log('%s button pressed again: off' % ('speaker' if member == 'setSpeakerMode' else 'mute'))
                    dialer_set(member, False)
        if mon is not None and mon.stdout in ready:
            # read the whole burst of signals of one change (raw reads: select sees no buffered lines) before acting
            while True:
                data = os.read(mon.stdout.fileno(), 65536)
                if not data:  # gdbus died (D-Bus restart?): start it again after a pause
                    mon.wait()
                    time.sleep(2)
                    mon, refresh, buf = monitor(), True, b''
                    break
                buf += data
                *lines, buf = buf.split(b'\n')
                for line in lines:
                    refresh = handle(line.decode(errors='replace'), calls) or refresh
                if not select.select([mon.stdout], [], [], 0.05)[0]:
                    break
        if time.monotonic() - listed >= period:
            refresh = True
        if refresh:
            calls, refresh, listed = list_calls(), False, time.monotonic()
        if ca.mode == 'voice':
            ca.follow_volume()
        want, now = wanted(calls), time.monotonic()
        if ringer.on and not ringing(calls):  # answered or another call up: at once; gone: after a grace
            if want == 'voice' or {st for st, _ in calls.values()} & {ACTIVE, HELD, DIALING, RINGING_OUT}:
                ringer.stop()
            elif ringer.off_since is None:
                ringer.off_since = now
            elif now - ringer.off_since >= RING_GRACE:
                ringer.stop()
        if want == 'voice' and ca.mode != 'voice' and now >= retry_at:
            if not ca.voice_on():
                retry_at = now + 2.0  # the modem's voice session may not exist yet: try again
        elif want == 'pre' and ca.mode == 'idle':
            ca.preroute()
        if ringing(calls):  # after the pre-route: it suspends the sink for a moment
            ringer.start()
        if want == 'idle' and ca.mode != 'idle':
            if ca.mode == 'voice' or (idle_since is not None and now - idle_since >= UNANSWERED_GRACE):
                ca.restore()
                idle_since = None
            elif idle_since is None:
                idle_since = now
        else:
            idle_since = None
    ringer.stop()
    if ca.mode != 'idle':
        ca.restore()
    if mon is not None:
        mon.terminate()


if __name__ == '__main__':
    sys.exit(main())
