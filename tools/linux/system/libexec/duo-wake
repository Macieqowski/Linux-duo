#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Surface Duo screen wake (2026-11-20). README: "Dzwonek, wibracja i budzenie ekranu".

KWin turns screens that are off (DPMS, after idle or the power key) back on at any key press; the session's
org.freedesktop.ScreenSaver.SimulateUserActivity does not wake them (tested). So a wake is one KEY_WAKEUP press on a
uinput keyboard that has only that key (not alphanumeric: KWin does not count it as a hardware keyboard).

  duo-wake                  wake the screens if they are off, unless the phone is closed (/run/duo-posture.state)
  duo-wake --force          also when closed (duo-posture, when the phone opens)
  duo-wake --notifications  daemon (duo-wake.service): keeps the uinput keyboard, takes the requests above on
                            /run/duo-wake.sock and wakes at each desktop notification of normal or critical urgency
                            (org.freedesktop.Notifications.Notify on the session bus); notifications off:
                            /etc/duo/wake-notify-off
A new uinput device needs ~1 s before KWin (libinput, through udev) uses it, which made opening the phone feel slow
(Maciej 2026-11-20): the daemon creates it once. Without the daemon a request makes its own device (the old 1 s path).
A request returns once the screens are on (max 2 s). Runs as root (/dev/uinput).
"""
import fcntl, glob, json, os, pwd, socket, struct, subprocess, sys, threading, time

POSTURE = '/run/duo-posture.state'
NOTIFY_OFF = '/etc/duo/wake-notify-off'
SOCK = '/run/duo-wake.sock'
UI_SET_EVBIT, UI_SET_KEYBIT, UI_DEV_SETUP, UI_DEV_CREATE, UI_DEV_DESTROY = (0x40045564, 0x40045565, 0x405c5503,
                                                                             0x5501, 0x5502)
EV_SYN, EV_KEY, KEY_WAKEUP = 0, 1, 143


def log(msg):
    print('%s %s' % (time.strftime('%H:%M:%S'), msg), flush=True)


def screens_off():
    """True if a DSI panel is off (DPMS); the posture's backlight-only blanking does not count."""
    for p in glob.glob('/sys/class/drm/card*-DSI-*/dpms'):
        try:
            if open(p).read().strip() == 'Off':
                return True
        except OSError:
            pass
    return False


def wait_on(limit=2.0):
    end = time.monotonic() + limit
    while screens_off() and time.monotonic() < end:
        time.sleep(0.05)
    return not screens_off()


def closed():
    try:
        return open(POSTURE).read().strip() == 'closed'
    except OSError:
        return False


class Keyboard:
    """a uinput device with KEY_WAKEUP only"""

    def __init__(self):
        self.fd = os.open('/dev/uinput', os.O_WRONLY | os.O_NONBLOCK)
        try:
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, KEY_WAKEUP)
            fcntl.ioctl(self.fd, UI_DEV_SETUP, struct.pack('HHHH80sI', 0x06, 0x045e, 0x0d00, 1, b'duo-wake', 0))
            fcntl.ioctl(self.fd, UI_DEV_CREATE)
        except OSError:
            os.close(self.fd)
            raise
        time.sleep(1.0)  # libinput/KWin pick the new device up through udev

    def press(self):
        for code, val in ((KEY_WAKEUP, 1), (0, 0), (KEY_WAKEUP, 0), (0, 0)):
            os.write(self.fd, struct.pack('llHHi', 0, 0, EV_KEY if code else EV_SYN, code, val))

    def close(self):
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        finally:
            os.close(self.fd)


def wake(kb, force=False, why=''):
    """kb: the daemon's keyboard, or None for a short-lived one"""
    if not screens_off():
        return False
    if closed() and not force:
        log('screens off, phone closed: no wake (%s)' % why)
        return False
    t = time.monotonic()
    if kb:
        kb.press()
        on = wait_on()
    else:
        k = Keyboard()
        try:
            k.press()
            on = wait_on()  # then the device can go
        finally:
            k.close()
    log('woke the screens (%s): %s after %.2f s' % (why, 'on' if on else 'still off', time.monotonic() - t))
    return True


def request(force, why):
    """ask the daemon; False if it does not run"""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        s.connect(SOCK)
        s.send(('%s:%s' % ('force' if force else 'wake', why)).encode()[:400])
        s.close()
    except OSError:
        return False
    if force or not closed():
        wait_on()
    return True


def session_user():
    for d in sorted(os.listdir('/run/user')) if os.path.isdir('/run/user') else []:
        if d != '0' and os.path.exists('/run/user/%s/bus' % d):
            try:
                return pwd.getpwuid(int(d))
            except (KeyError, ValueError):
                pass
    return None


def notifications(do_wake):
    """Wake at desktop notifications: busctl monitor on the session bus, as the session's user."""
    log('waking the screens at notifications')
    while True:
        u = session_user()
        if not u:
            time.sleep(5)
            continue
        env = {'DBUS_SESSION_BUS_ADDRESS': 'unix:path=/run/user/%d/bus' % u.pw_uid, 'PATH': '/usr/bin:/bin',
               'HOME': u.pw_dir, 'XDG_RUNTIME_DIR': '/run/user/%d' % u.pw_uid}
        mon = subprocess.Popen(['busctl', '--user', 'monitor', '--json=short', '--match',
                                "type='method_call',interface='org.freedesktop.Notifications',member='Notify'"],
                               user=u.pw_uid, group=u.pw_gid, env=env, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, text=True)
        last = 0.0
        for line in mon.stdout:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            if m.get('member') != 'Notify' or os.path.exists(NOTIFY_OFF):
                continue
            data = (m.get('payload') or {}).get('data') or []
            app = data[0] if data and isinstance(data[0], str) else '?'
            hints = data[6] if len(data) > 6 and isinstance(data[6], dict) else {}
            urgency = hints.get('urgency', {}).get('data', 1) if isinstance(hints.get('urgency'), dict) else 1
            if urgency == 0 or time.monotonic() - last < 3:  # low urgency, or a burst
                continue
            last = time.monotonic()
            do_wake(False, 'notification from %s' % app)
        mon.wait()
        time.sleep(5)  # the session ended (log out, restart): find it again


def daemon():
    kb = Keyboard()
    lock = threading.Lock()

    def do_wake(force, why):
        with lock:  # one press at a time; a second request while the screens come on finds them on
            try:
                wake(kb, force, why)
            except OSError as e:
                log('wake failed (%s): %s' % (why, e))

    try:
        os.unlink(SOCK)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    srv.bind(SOCK)
    os.chmod(SOCK, 0o600)
    threading.Thread(target=notifications, args=(do_wake,), daemon=True).start()
    log('keyboard ready, requests on %s' % SOCK)
    while True:
        force, _, why = srv.recv(512).decode(errors='replace').partition(':')
        threading.Thread(target=do_wake, args=(force == 'force', why), daemon=True).start()


def main():
    if '--notifications' in sys.argv:
        return daemon()
    force = '--force' in sys.argv
    why = ' '.join(a for a in sys.argv[1:] if a != '--force') or 'request'
    if not request(force, why):
        wake(None, force, why)
    return 0


if __name__ == '__main__':
    sys.exit(main())
