# Surface Duo screen wake (duo-wake): keeps the uinput wake keyboard (a new one takes KWin ~1 s) for the requests of
# duo-call-audio (calls) and duo-posture (opening) on /run/duo-wake.sock, and wakes at desktop notifications
# (off: touch /etc/duo/wake-notify-off).
[Unit]
Description=Surface Duo screen wake (calls, notifications, opening)
After=display-manager.service

[Service]
Type=simple
ExecStart=/usr/libexec/duo/duo-wake --notifications
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
