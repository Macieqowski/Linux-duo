# Surface Duo touch position correction (duo-touch-fix): corrected copies of iptsd's touchscreens, with the per-screen
# calibration from "Kalibracja dotyku" (duo-touch-calib, /etc/duo/touch-calibration.json). Stopped = plain iptsd.
[Unit]
Description=Surface Duo touch position correction
After=duo-hw.service systemd-udevd.service
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/libexec/duo/duo-touch-fix
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/duo-touch-fix.log
StandardError=append:/var/log/duo-touch-fix.log

[Install]
WantedBy=multi-user.target
