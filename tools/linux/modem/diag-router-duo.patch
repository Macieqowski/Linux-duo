diff --git a/router/peripheral-qrtr.c b/router/peripheral-qrtr.c
index 9a3c59a..05715fb 100644
--- a/router/peripheral-qrtr.c
+++ b/router/peripheral-qrtr.c
@@ -63,6 +63,65 @@ enum {
 	DIAG_INSTANCE_DCI,
 };
 
+/*
+ * A peripheral packs several non-HDLC frames (0x7e 0x01 len16 payload 0x7e) into one QRTR packet
+ * (downstream diag_add_hdlc_encoding() walks them all); forward every frame, not just the first.
+ */
+static unsigned long qrtr_stat_pkts[16], qrtr_stat_frames[16], qrtr_stat_bytes[16], qrtr_stat_bad[16];
+
+static int qrtr_perif_idx(struct peripheral *perif)
+{
+	struct list_head *item;
+	int i = 0;
+
+	list_for_each(item, &peripherals) {
+		if (container_of(item, struct peripheral, node) == perif)
+			return i & 15;
+		i++;
+	}
+	return 15;
+}
+
+static void qrtr_forward_frames(struct peripheral *perif, const uint8_t *p, size_t left,
+				struct watch_flow *flow)
+{
+	int idx = qrtr_perif_idx(perif);
+
+	qrtr_stat_pkts[idx]++;
+	qrtr_stat_bytes[idx] += left;
+	while (left >= 5) {
+		size_t len = p[2] | p[3] << 8;
+
+		if (p[0] != 0x7e || p[1] != 1 || 4 + len + 1 > left || p[4 + len] != 0x7e) {
+			qrtr_stat_bad[idx]++;
+			if (qrtr_stat_bad[idx] <= 5)
+				fprintf(stderr, "[%s] bad non-HDLC frame at %zu bytes left: %02x %02x len %zu\n",
+					perif->name, left, p[0], p[1], len);
+			break;
+		}
+		dm_broadcast(p + 4, len, flow);
+		qrtr_stat_frames[idx]++;
+		p += 4 + len + 1;
+		left -= 4 + len + 1;
+	}
+}
+
+static void qrtr_stats(void *data)
+{
+	struct list_head *item;
+	int i = 0;
+
+	list_for_each(item, &peripherals) {
+		struct peripheral *perif = container_of(item, struct peripheral, node);
+
+		if (qrtr_stat_pkts[i & 15])
+			printf("[%s] data: %lu pkts %lu frames %lu bytes %lu bad\n", perif->name,
+			       qrtr_stat_pkts[i & 15], qrtr_stat_frames[i & 15], qrtr_stat_bytes[i & 15],
+			       qrtr_stat_bad[i & 15]);
+		i++;
+	}
+}
+
